// CRM de Vendas & Orçamentos — Móveis
// Schema completo (Seção 4 do PROMPT MESTRE)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PapelUsuario {
  VENDEDOR
  ASSISTENTE
  ADMIN
}

enum PotencialVendas {
  ALTO
  MEDIO
  BAIXO
}

enum StatusNegocio {
  ABERTO
  VENDIDO
  CANCELADO
}

enum StatusAtividade {
  SEM_ATIVIDADES
  PLANEJADA
  ATRASADA
  CONCLUIDA
}

enum TipoTimelineEvent {
  ATIVIDADE
  NOTA
  IMAGEM
  ARQUIVO
  WHATSAPP
  LOG
  NOTA_INTERNA
}

enum TipoImagemProduto {
  TECNICA
  AMBIENTE
}

enum StatusVersaoOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  REJEITADO
}

enum StatusPedidoCompra {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

enum TipoCupom {
  PERCENTUAL
  VALOR_FIXO
}

// ---------------------------------------------------------------------------
// Usuários e Cadastros Base
// ---------------------------------------------------------------------------

model User {
  id        String       @id @default(cuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(VENDEDOR)
  ativo     Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  negociosResponsavel    Negocio[]         @relation("NegocioResponsavel")
  negociosCompartilhados Negocio[]         @relation("NegocioCompartilhadoCom")
  atividadesResponsavel  Atividade[]       @relation("AtividadeResponsaveis")
  notas                  Nota[]
  notasInternas          NotaInterna[]
  timelineEvents         TimelineEvent[]
  versoesResponsavel     VersaoOrcamento[] @relation("VersaoResponsavel")
  versoesCompartilhadas  VersaoOrcamento[] @relation("VersaoCompartilhadaCom")

  @@map("users")
}

model Cliente {
  id        String    @id @default(cuid())
  nome      String
  telefone  String?
  whatsapp  String?
  email     String?
  documento String?
  endereco  Json?
  obs       String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  negocios Negocio[]
  versoes  VersaoOrcamento[]

  @@map("clientes")
}

model Escritorio {
  id           String   @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  documento    String?
  contato      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  especificadores Especificador[]
  negocios        Negocio[]
  versoes         VersaoOrcamento[]

  @@map("escritorios")
}

model Especificador {
  id           String      @id @default(cuid())
  nome         String
  whatsapp     String?
  email        String?
  escritorioId String?
  escritorio   Escritorio? @relation(fields: [escritorioId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  negocios Negocio[]
  versoes  VersaoOrcamento[]

  @@map("especificadores")
}

model Construtora {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negocios Negocio[]
  versoes  VersaoOrcamento[]

  @@map("construtoras")
}

model Fabricante {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[]

  @@map("fabricantes")
}

model CategoriaProduto {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[] @relation("ProdutoCategorias")

  @@map("categorias_produto")
}

// ---------------------------------------------------------------------------
// Funil de Vendas
// ---------------------------------------------------------------------------

model Funil {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etapas   EtapaFunil[]
  negocios Negocio[]

  @@map("funis")
}

model EtapaFunil {
  id      String @id @default(cuid())
  funilId String
  funil   Funil  @relation(fields: [funilId], references: [id], onDelete: Cascade)
  nome    String
  ordem   Int
  cor     String @default("#64748b")

  negocios Negocio[]

  @@unique([funilId, ordem])
  @@map("etapas_funil")
}

model MotivoPerda {
  id    String  @id @default(cuid())
  nome  String
  ativo Boolean @default(true)

  negocios Negocio[]

  @@map("motivos_perda")
}

model Etiqueta {
  id   String @id @default(cuid())
  nome String
  cor  String @default("#64748b")

  negocios Negocio[]         @relation("NegocioEtiquetas")
  versoes  VersaoOrcamento[] @relation("VersaoEtiquetas")

  @@map("etiquetas")
}

// ---------------------------------------------------------------------------
// Negócio
// ---------------------------------------------------------------------------

model Negocio {
  id                 String           @id @default(cuid())
  numero             Int              @unique @default(autoincrement())
  titulo             String
  clienteId          String
  cliente            Cliente          @relation(fields: [clienteId], references: [id])
  responsavelId      String
  responsavel        User             @relation("NegocioResponsavel", fields: [responsavelId], references: [id])
  compartilhadoCom   User[]           @relation("NegocioCompartilhadoCom")
  especificadorId    String?
  especificador      Especificador?   @relation(fields: [especificadorId], references: [id])
  escritorioId       String?
  escritorio         Escritorio?      @relation(fields: [escritorioId], references: [id])
  construtoraId      String?
  construtora        Construtora?     @relation(fields: [construtoraId], references: [id])
  funilId            String
  funil              Funil            @relation(fields: [funilId], references: [id])
  etapaId            String
  etapa              EtapaFunil       @relation(fields: [etapaId], references: [id])
  valor              Decimal          @default(0) @db.Decimal(14, 2)
  previsaoFechamento DateTime?        @db.Date
  dataEntrega        DateTime?        @db.Date
  potencialVendas    PotencialVendas?
  referenciaExterna  String?
  origem             String?
  status             StatusNegocio    @default(ABERTO)
  motivoPerdaId      String?
  motivoPerda        MotivoPerda?     @relation(fields: [motivoPerdaId], references: [id])
  etiquetas          Etiqueta[]       @relation("NegocioEtiquetas")
  codReferencia      String?
  inicio             DateTime         @default(now()) @db.Date
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  atividades     Atividade[]
  notas          Nota[]
  anexos         Anexo[]
  notasInternas  NotaInterna[]
  timelineEvents TimelineEvent[]
  orcamento      Orcamento?

  @@map("negocios")
}

model Atividade {
  id            String          @id @default(cuid())
  negocioId     String
  negocio       Negocio         @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  titulo        String
  tipoAtividade String
  data          DateTime        @db.Date
  hora          String?
  duracao       String?
  descricao     String?
  status        StatusAtividade @default(PLANEJADA)
  responsaveis  User[]          @relation("AtividadeResponsaveis")
  participantes String[]        @default([])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("atividades")
}

model Nota {
  id        String   @id @default(cuid())
  negocioId String
  negocio   Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id])
  texto     String
  createdAt DateTime @default(now())

  @@map("notas")
}

model Anexo {
  id          String   @id @default(cuid())
  negocioId   String
  negocio     Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  nomeArquivo String
  url         String
  mime        String?
  tamanho     Int?
  createdAt   DateTime @default(now())

  @@map("anexos")
}

model NotaInterna {
  id        String   @id @default(cuid())
  negocioId String
  negocio   Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id])
  texto     String
  createdAt DateTime @default(now())

  @@map("notas_internas")
}

model TimelineEvent {
  id        String            @id @default(cuid())
  negocioId String
  negocio   Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  tipo      TipoTimelineEvent
  payload   Json?
  autorId   String?
  autor     User?             @relation(fields: [autorId], references: [id])
  createdAt DateTime          @default(now())

  @@map("timeline_events")
}

// ---------------------------------------------------------------------------
// Orçamento
// ---------------------------------------------------------------------------

model Orcamento {
  id            String           @id @default(cuid())
  numero        Int              @unique @default(autoincrement())
  negocioId     String           @unique
  negocio       Negocio          @relation(fields: [negocioId], references: [id])
  versaoAtualId String?          @unique
  versaoAtual   VersaoOrcamento? @relation("OrcamentoVersaoAtual", fields: [versaoAtualId], references: [id])
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  versoes VersaoOrcamento[] @relation("OrcamentoVersoes")
  pedidos PedidoCompra[]

  @@map("orcamentos")
}

model VersaoOrcamento {
  id                String                @id @default(cuid())
  orcamentoId       String
  orcamento         Orcamento             @relation("OrcamentoVersoes", fields: [orcamentoId], references: [id], onDelete: Cascade)
  numeroVersao      Int                   @unique @default(autoincrement())
  responsavelId     String?
  responsavel       User?                 @relation("VersaoResponsavel", fields: [responsavelId], references: [id])
  compartilhadoCom  User[]                @relation("VersaoCompartilhadaCom")
  clienteId         String?
  cliente           Cliente?              @relation(fields: [clienteId], references: [id])
  especificadorId   String?
  especificador     Especificador?        @relation(fields: [especificadorId], references: [id])
  escritorioId      String?
  escritorio        Escritorio?           @relation(fields: [escritorioId], references: [id])
  rt                Decimal               @default(0) @db.Decimal(6, 2)
  construtoraId     String?
  construtora       Construtora?          @relation(fields: [construtoraId], references: [id])
  referenciaExterna String?
  origem            String?
  etiquetas         Etiqueta[]            @relation("VersaoEtiquetas")
  status            StatusVersaoOrcamento @default(RASCUNHO)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  itens          ItemOrcamento[]
  orcamentoAtual Orcamento?      @relation("OrcamentoVersaoAtual")

  @@map("versoes_orcamento")
}

model ItemOrcamento {
  id             String          @id @default(cuid())
  versaoId       String
  versao         VersaoOrcamento @relation(fields: [versaoId], references: [id], onDelete: Cascade)
  produtoId      String?
  produto        Produto?        @relation(fields: [produtoId], references: [id])
  descricao      String?
  nomeOriginal   String?
  fabricanteNome String?
  quantidade     Int             @default(1)
  precoUnitario  Decimal         @default(0) @db.Decimal(14, 2)
  total          Decimal         @default(0) @db.Decimal(14, 2)
  notaInterna    String?
  ordem          Int             @default(0)
  removido       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("itens_orcamento")
}

// ---------------------------------------------------------------------------
// Catálogo de Produtos
// ---------------------------------------------------------------------------

model Produto {
  id                  String             @id @default(cuid())
  categorias          CategoriaProduto[] @relation("ProdutoCategorias")
  nome                String
  fabricanteId        String?
  fabricante          Fabricante?        @relation(fields: [fabricanteId], references: [id])
  skuFabrica          String?
  ean                 String?
  referenciaLoja      String?
  atributos           Json?
  descricao           String?
  valorUnitario       Decimal            @default(0) @db.Decimal(14, 2)
  unidade             String             @default("unidades")
  grupo               String             @default("Serviços/Produtos")
  medidaPersonalizada String?
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  imagens        ImagemProduto[]
  itensOrcamento ItemOrcamento[]

  @@map("produtos")
}

model ImagemProduto {
  id        String            @id @default(cuid())
  produtoId String
  produto   Produto           @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  url       String
  tipo      TipoImagemProduto
  ordem     Int               @default(0)
  createdAt DateTime          @default(now())

  @@map("imagens_produto")
}

// ---------------------------------------------------------------------------
// Suporte a Orçamentos / Configurações
// ---------------------------------------------------------------------------

model FormaPagamento {
  id        String   @id @default(cuid())
  nome      String
  config    Json?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("formas_pagamento")
}

model BancoMensagem {
  id        String   @id @default(cuid())
  titulo    String
  texto     String
  categoria String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banco_mensagens")
}

model PedidoCompra {
  id          String             @id @default(cuid())
  orcamentoId String
  orcamento   Orcamento          @relation(fields: [orcamentoId], references: [id])
  numero      Int                @unique @default(autoincrement())
  status      StatusPedidoCompra @default(PENDENTE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("pedidos_compra")
}

model Cupom {
  id        String    @id @default(cuid())
  codigo    String    @unique
  tipo      TipoCupom
  valor     Decimal   @db.Decimal(14, 2)
  validade  DateTime? @db.Date
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("cupons")
}
